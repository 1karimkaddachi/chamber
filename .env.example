# ─────────────────────────────────────────────────────────────
# Chamber environment configuration
# Copy this file to .env and fill in the values you need.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
API_PORT=3100
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5174
SERVE_WEB=false
TRUST_PROXY=false
LOG_LEVEL=info

# PostgreSQL
# Create both databases; npm run test:prepare migrates the test database.
TEST_DATABASE_URL=postgresql://chamber:chamber@localhost:5432/chamber_test?schema=public
DATABASE_URL=postgresql://chamber:chamber@localhost:5432/chamber?schema=public

# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3100/api/auth/callback

# Session signing. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=7

# Development-only login (never enable in production)
DEV_AUTH=false
DEV_AUTH_USER_ID=
DEV_AUTH_USERNAME=Dev Operator
DEV_AUTH_GUILD_ID=

# Optional AI assistant (OpenAI-compatible endpoint or local Ollama)
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Uploads (room banners) on the local filesystem, resolved from the project root
STORAGE_DIR=./storage

# ─────────────────────────────────────────────────────────────
# Docker Compose (only used by docker-compose.yml)
# ─────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD=change-me
# PUBLIC_WEB_ORIGIN=http://localhost:3000
# APP_PORT=3000
