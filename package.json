{
  "name": "chamber",
  "version": "1.0.0",
  "private": true,
  "description": "Chamber \u2014 a production-grade temporary voice channel platform for Discord with a real-time control dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @chamber/server",
    "dev:web": "npm run dev -w @chamber/web",
    "build": "npm run build -w @chamber/web",
    "start": "node apps/server/src/index.js",
    "db:generate": "npm run generate -w @chamber/db",
    "db:migrate": "npm run migrate -w @chamber/db",
    "db:deploy": "npm run migrate:deploy -w @chamber/db",
    "db:seed": "npm run seed -w @chamber/db",
    "db:studio": "npm run studio -w @chamber/db",
    "test": "npm run test -w @chamber/server",
    "test:watch": "npm run test:watch -w @chamber/server",
    "typecheck": "npm run typecheck -w @chamber/web",
    "test:prepare": "dotenv -e .env -- node scripts/prepare-test-db.mjs",
    "deps:bindings": "node scripts/ensure-rollup-binding.mjs",
    "qa:visual": "node scripts/visual-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.1.0",
    "playwright-core": "^1.64.1"
  },
  "license": "MIT",
  "author": "Chamber contributors"
}
